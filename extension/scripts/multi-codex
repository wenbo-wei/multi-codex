#!/usr/bin/env bash

set -uo pipefail

usage() {
  printf 'Usage: multi-codex [--panel]\n'
}

panel_mode=false
case "$#" in
  0)
    ;;
  1)
    if [ "$1" != "--panel" ]; then
      usage >&2
      exit 2
    fi
    panel_mode=true
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac

if ! script_dir=$(
    CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &&
      pwd -P
); then
  printf 'Multi Codex could not resolve its runtime directory.\n' >&2
  exit 1
fi

layout_command=${MULTI_CODEX_LAYOUT_COMMAND:-"$script_dir/open-six-terminals"}
declare -ar layout_invocation=(
  env MULTI_CODEX_LAYOUT_BOUNDED=1 "$layout_command"
)

readonly ACTIVATION_TIMEOUT_SECONDS=18
readonly CLEANUP_TIMEOUT_SECONDS=5
readonly LAYOUT_STATUS_MISSING=3
readonly LAYOUT_STATUS_STARTING=4
deadline=$((SECONDS + ACTIVATION_TIMEOUT_SECONDS))

run_before_deadline() {
  local remaining=$((deadline - SECONDS))
  if [ "$remaining" -le 0 ]; then
    return 124
  fi
  timeout \
    --signal=TERM \
    --kill-after=1s \
    "${remaining}s" \
    "$@"
}

layout_phase_output=
run_layout_phase() {
  local phase_status
  layout_phase_output=
  while [ "$SECONDS" -lt "$deadline" ]; do
    if layout_phase_output=$(
        run_before_deadline "${layout_invocation[@]}" "$@"
    ); then
      return 0
    else
      phase_status=$?
    fi
    case "$phase_status" in
      "$LAYOUT_STATUS_MISSING"|"$LAYOUT_STATUS_STARTING")
        sleep 0.1
        ;;
      *)
        return "$phase_status"
        ;;
    esac
  done
  return 124
}

created_units=()
launching_unit=
completed=false

cleanup_created() {
  local unit
  local -a units
  units=("${created_units[@]}")
  if [ -n "$launching_unit" ]; then
    for unit in "${units[@]}"; do
      if [ "$unit" = "$launching_unit" ]; then
        launching_unit=
        break
      fi
    done
    if [ -n "$launching_unit" ]; then
      units+=("$launching_unit")
    fi
  fi
  if [ "${#units[@]}" -eq 0 ]; then
    return 0
  fi
  timeout \
    --signal=TERM \
    --kill-after=1s \
    "${CLEANUP_TIMEOUT_SECONDS}s" \
    systemctl --user stop "${units[@]}" >/dev/null 2>&1
}

finish() {
  local exit_status=$?
  trap - EXIT HUP INT TERM
  if [ "$completed" != true ]; then
    if ! cleanup_created; then
      printf 'Multi Codex rollback could not be confirmed; check multi-codex-terminal-*.service manually.\n' >&2
    fi
  fi
  exit "$exit_status"
}
trap finish EXIT
trap 'exit 130' HUP INT TERM

abort_creation() {
  if [ "${#created_units[@]}" -eq 0 ] && [ -z "$launching_unit" ]; then
    printf 'Multi Codex could not obtain a complete six-terminal set; existing sessions were preserved.\n' >&2
  else
    printf 'Multi Codex could not create a complete six-terminal set; rolling back only the newly created sessions.\n' >&2
  fi
  exit 1
}

# The layout helper is the single owner of slot identity. A missing slot can be
# created; a starting slot is retried without creating a duplicate; every other
# nonzero result remains a fail-closed error.
if ! run_layout_phase --missing; then
  abort_creation
fi
missing_output=$layout_phase_output

missing_slots=()
if [ -n "$missing_output" ]; then
  mapfile -t missing_slots <<< "$missing_output"
fi
declare -A seen_slots
seen_slots=()
for i in "${missing_slots[@]}"; do
  if ! [[ "$i" =~ ^[1-6]$ ]] || [ -n "${seen_slots[$i]:-}" ]; then
    printf 'Multi Codex received an invalid slot list from the layout helper.\n' >&2
    abort_creation
  fi
  seen_slots[$i]=1
done

for i in "${missing_slots[@]}"; do
  launching_unit="multi-codex-terminal-$i.service"
  if run_before_deadline systemd-run --user \
      --quiet \
      --collect \
      --property=PartOf=graphical-session.target \
      --property=After=graphical-session.target \
      --unit="multi-codex-terminal-$i" \
      --setenv=GDK_BACKEND=x11 \
      /usr/bin/ptyxis --standalone "--title=Terminal $i"; then
    created_units+=("$launching_unit")
    launching_unit=
  else
    launch_status=$?
    # A normal systemd-run rejection did not create our unit. A timeout is
    # ambiguous, so keep the name tracked and let the EXIT trap stop it.
    if [ "$launch_status" -ne 124 ] &&
        [ "$launch_status" -ne 137 ]; then
      launching_unit=
    fi
    abort_creation
  fi
done

if ! run_layout_phase --check >/dev/null 2>&1; then
  abort_creation
fi

layout_options=()
if [ "$panel_mode" = true ]; then
  layout_options+=(--panel)
fi
if ! run_layout_phase "${layout_options[@]}"; then
  abort_creation
fi

completed=true
trap - HUP INT TERM
exit 0
